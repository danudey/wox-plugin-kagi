    },
    {
      "Type": "label",
      "Value": {
        "Content": "Type the plugin trigger keyword, then a service keyword, then your query. For example: kagi img red pandas. A service with an empty keyword is only reachable from the service list, except for Web Search, which is what an unprefixed query falls back to.",
        "Tooltip": "",
        "Style": {}
      }
    },
    {
