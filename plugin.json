{
  "Id": "93b96f6e-4668-4a2d-8e40-232cf05769aa",
  "Name": "Kagi",
  "Description": "Search Kagi and its verticals: web, images, videos, news, podcasts, maps, translate, assistant, summarizer and more",
  "Author": "Daniel Fox",
  "Version": "1.0.0",
  "MinWoxVersion": "2.0.0",
  "Runtime": "python",
  "Website": "https://github.com/danudey/wox-plugin-kagi",
  "Entry": "main.py",
  "Icon": "relative:images/app.svg",
  "TriggerKeywords": [
    "kagi",
    "k"
  ],
  "SupportedOS": [
    "windows",
    "linux",
    "darwin"
  ],
  "Features": [
    {
      "Name": "debounce",
      "Params": {
        "IntervalMs": 250
      }
    }
  ],
  "SettingDefinitions": [
    {
      "Type": "head",
      "Value": {
        "Content": "Autocomplete",
        "Tooltip": "Suggestions come from Kagi's free autocomplete endpoint and need no API key.",
        "Style": {}
      }
    },
    {
      "Type": "checkbox",
      "Value": {
        "Key": "suggestions_enabled",
        "Label": "Show Kagi autocomplete suggestions",
        "DefaultValue": "true",
        "Tooltip": "Ask kagisuggest.com for completions of what you are typing.",
        "Style": {}
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "suggestions_limit",
        "Label": "Maximum suggestions",
        "DefaultValue": "6",
        "Tooltip": "How many suggestions to list, 0 to 15.",
        "Suffix": "",
        "MaxLines": 1,
        "Validators": [
          {
            "Type": "is_number",
            "Value": {
              "IsInteger": true,
              "IsFloat": false
            }
          }
        ],
        "Style": {
          "Width": 120
        }
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "request_timeout",
        "Label": "Network timeout",
        "DefaultValue": "6",
        "Tooltip": "Seconds to wait for Kagi before giving up.",
        "Suffix": "s",
        "MaxLines": 1,
        "Validators": [
          {
            "Type": "is_number",
            "Value": {
              "IsInteger": true,
              "IsFloat": false
            }
          }
        ],
        "Style": {
          "Width": 120
        }
      }
    },
    {
      "Type": "newline",
      "Value": {
        "Style": {}
      }
    },
    {
      "Type": "head",
      "Value": {
        "Content": "Kagi API",
        "Tooltip": "Only needed for inline answers. Every API call below spends credit on your Kagi account.",
        "Style": {}
      }
    },
    {
      "Type": "label",
      "Value": {
        "Content": "Create a key at kagi.com/settings?p=api. Leave this empty to use the plugin as a launcher only, which needs no key and costs nothing.",
        "Tooltip": "",
        "Style": {}
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "api_key",
        "Label": "API key",
        "DefaultValue": "",
        "Tooltip": "Sent as an Authorization: Bot header.",
        "Suffix": "",
        "MaxLines": 1,
        "Validators": [],
        "Style": {
          "Width": 420
        }
      }
    },
    {
      "Type": "checkbox",
      "Value": {
        "Key": "api_search_inline",
        "Label": "Show web, news and small web results inline (paid)",
        "DefaultValue": "false",
        "Tooltip": "Calls the Kagi Search and Enrichment APIs on every query. Billed per search.",
        "Style": {}
      }
    },
    {
      "Type": "checkbox",
      "Value": {
        "Key": "api_fastgpt_inline",
        "Label": "Answer Quick Answer queries inline (paid)",
        "DefaultValue": "false",
        "Tooltip": "Calls the FastGPT API. Billed per query.",
        "Style": {}
      }
    },
    {
      "Type": "checkbox",
      "Value": {
        "Key": "api_summarizer_inline",
        "Label": "Summarize inline (paid)",
        "DefaultValue": "false",
        "Tooltip": "Calls the Universal Summarizer API. Billed per token.",
        "Style": {}
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "api_result_limit",
        "Label": "Inline results per query",
        "DefaultValue": "5",
        "Tooltip": "How many API results to list, 1 to 20.",
        "Suffix": "",
        "MaxLines": 1,
        "Validators": [
          {
            "Type": "is_number",
            "Value": {
              "IsInteger": true,
              "IsFloat": false
            }
          }
        ],
        "Style": {
          "Width": 120
        }
      }
    },
    {
      "Type": "newline",
      "Value": {
        "Style": {}
      }
    },
    {
      "Type": "head",
      "Value": {
        "Content": "Translate and summarize options",
        "Tooltip": "",
        "Style": {}
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "translate_source",
        "Label": "Translate from",
        "DefaultValue": "auto",
        "Tooltip": "Language code, or \"auto\" to let Kagi detect it.",
        "Suffix": "",
        "MaxLines": 1,
        "Validators": [],
        "Style": {
          "Width": 160
        }
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "translate_target",
        "Label": "Translate into",
        "DefaultValue": "en",
        "Tooltip": "Language code such as en, fr or ja. Override per query with a trailing \"> fr\".",
        "Suffix": "",
        "MaxLines": 1,
        "Validators": [],
        "Style": {
          "Width": 160
        }
      }
    },
    {
      "Type": "select",
      "Value": {
        "Key": "summarizer_engine",
        "Label": "Summarizer engine",
        "DefaultValue": "cecil",
        "Tooltip": "",
        "IsMulti": false,
        "Options": [
          {
            "Label": "Cecil — friendly, general purpose",
            "Value": "cecil"
          },
          {
            "Label": "Agnes — formal, technical",
            "Value": "agnes"
          },
          {
            "Label": "Daphne — informal, creative",
            "Value": "daphne"
          },
          {
            "Label": "Muriel — highest quality, flat fee",
            "Value": "muriel"
          }
        ],
        "Validators": [],
        "Style": {
          "Width": 220
        }
      }
    },
    {
      "Type": "select",
      "Value": {
        "Key": "summarizer_type",
        "Label": "Summary style",
        "DefaultValue": "summary",
        "Tooltip": "",
        "IsMulti": false,
        "Options": [
          {
            "Label": "Paragraph summary",
            "Value": "summary"
          },
          {
            "Label": "Key takeaways",
            "Value": "takeaway"
